.env
.pi-glla/
evals/.cache/
evals/results/
mcp.json
node_modules

# Transient three-arm config run.sh writes beside a suite when comparing versions
skills/*/evals/.promptfooconfig.3arm.yaml

# Suite-local fixture caches (checked-out repos; one suite puts them beside itself
# rather than in evals/.cache, and 55MB of vendored source must never be tracked)
skills/*/evals/.cache/

# Generated by apc.mjs from mcp.json - both carry the langfuse credential, neither is tracked
.mcp.json
